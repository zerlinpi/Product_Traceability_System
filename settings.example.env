PTS_ENV=production
PTS_SECRET_KEY=replace-with-at-least-32-random-characters
PTS_BOOTSTRAP_ADMIN_USERNAME=admin
PTS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password
PTS_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
PTS_HTTPS_ONLY=0
TRACE_HOST=127.0.0.1
TRACE_PORT=5080

# Lingxing OpenAPI credentials. Keep write endpoints empty until Lingxing has
# enabled the matching APIs for this account and supplied their exact paths.
PTS_LINGXING_APP_ID=replace-with-lingxing-app-id
PTS_LINGXING_APP_SECRET=replace-with-lingxing-app-secret
PTS_LINGXING_API_BASE_URL=https://openapi.lingxing.com
PTS_LINGXING_PURCHASE_ORDER_URL=
PTS_LINGXING_INBOUND_URL=
PTS_LINGXING_INVENTORY_URL=

# Outbound endpoint policy (SSRF defence).
#
# By default the Lingxing feature may only contact openapi.lingxing.com, and
# only over HTTPS. Prefer relative paths (e.g. /erp/sc/routing/...) for the
# *_URL settings above: a relative path cannot change which host is contacted.
#
# Only set these if you genuinely need another host — and prefer an allowlist
# entry over PTS_LINGXING_ALLOW_PRIVATE_HOSTS, which disables the internal
# address checks entirely.
#
# Comma-separated extra hosts allowed in addition to openapi.lingxing.com.
PTS_LINGXING_ALLOWED_HOSTS=
# 1 = permit plain HTTP. Ignored when PTS_ENV=production.
PTS_LINGXING_ALLOW_HTTP=0
# 1 = also permit loopback / link-local / private addresses (lab use only).
PTS_LINGXING_ALLOW_PRIVATE_HOSTS=0
